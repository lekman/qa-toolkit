# Shared editor settings. Prettier reads the indentation and line-ending
# settings below, so they are set only where Prettier does not format.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Kotlin: ktlint's official style (trunk runs ktlint; the JVM build runs it too).
[*.{kt,kts}]
indent_style = space
indent_size = 4
ktlint_code_style = ktlint_official

# Java: google-java-format decides the layout; this only keeps editors in step.
[*.java]
indent_style = space
indent_size = 2

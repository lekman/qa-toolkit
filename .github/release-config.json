{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "@",
  "separate-pull-requests": false,
  "changelog-path": "CHANGELOG.md",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "build",
      "section": "Build and tooling"
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Style",
      "hidden": true
    }
  ],
  "packages": {
    "packages/data-sampler": {
      "release-type": "node",
      "package-name": "@lekman/data-sampler",
      "component": "data-sampler",
      "initial-version": "0.1.0"
    },
    "packages/qualify-ts": {
      "release-type": "node",
      "package-name": "@lekman/qualify",
      "component": "qualify",
      "initial-version": "0.1.0"
    },
    "packages/qualify-python": {
      "release-type": "python",
      "package-name": "lekman-qualify",
      "component": "qualify-python",
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='lekman-qualify')].version"
        }
      ]
    },
    "packages/qualify-jvm": {
      "release-type": "simple",
      "package-name": "com.lekman:qualify",
      "component": "qualify-jvm",
      "initial-version": "0.1.0",
      "extra-files": ["gradle.properties"]
    },
    "packages/qualify-dotnet": {
      "release-type": "simple",
      "package-name": "Lekman.Qualify",
      "component": "qualify-dotnet",
      "initial-version": "0.1.0",
      "extra-files": ["Directory.Build.props"]
    },
    "packages/qualify-vscode": {
      "release-type": "node",
      "package-name": "qualify-vscode",
      "component": "qualify-vscode",
      "initial-version": "0.1.0"
    }
  }
}

{
  "$schema": "./runner.schema.json",
  "id": "vitest",
  "label": "vitest",
  "framework": "vitest",
  "files": [
    "**/*{.,_}{test,spec}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "**/test/**/*.{ts,mts,cts,js,mjs,cjs}"
  ],
  "command": "${tool} vitest run ${filter}",
  "tools": [
    {
      "file": "bun.lock",
      "value": "bunx"
    },
    {
      "file": "bun.lockb",
      "value": "bunx"
    },
    {
      "file": "pnpm-lock.yaml",
      "value": "pnpm exec"
    },
    {
      "file": "yarn.lock",
      "value": "yarn"
    },
    {
      "value": "npx"
    }
  ],
  "select": {
    "term": "\\[${id}\\]",
    "join": "|",
    "quote": "all",
    "argument": "-t ${terms}"
  },
  "qualify": true,
  "junit": {
    "args": "--reporter=default --reporter=junit --outputFile.junit=${junitFile}",
    "file": "test-results/junit/vitest.xml"
  }
}

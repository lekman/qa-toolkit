{
  "$schema": "./runner.schema.json",
  "id": "node-test",
  "label": "node:test",
  "framework": "node",
  "files": [
    "**/*{.,_}{test,spec}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "**/test/**/*.{ts,mts,cts,js,mjs,cjs}"
  ],
  "command": "node --test ${filter}",
  "tools": [],
  "select": {
    "term": "\\[${id}\\]",
    "join": "|",
    "quote": "all",
    "argument": "--test-name-pattern=${terms}"
  },
  "qualify": true,
  "junit": {
    "args": "--test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=${junitFile}",
    "file": "test-results/junit/node-test.xml"
  }
}

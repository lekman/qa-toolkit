{
  "$schema": "./runner.schema.json",
  "id": "dotnet",
  "label": "xUnit v3 with dotnet test",
  "framework": "xunit",
  "files": ["**/*Test*/**/*.cs", "**/*Test*.cs"],
  "command": "dotnet test ${filter}",
  "tools": [],
  "select": {
    "term": "DisplayName~${id}",
    "join": "|",
    "quote": "all",
    "argument": "--filter ${terms}"
  },
  "qualify": true,
  "junit": {
    "args": "--logger 'junit;LogFilePath=${junitFile}'",
    "file": "test-results/junit/dotnet.xml",
    "requires": "the JunitXml.TestLogger NuGet package in the test project, on the VSTest host"
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <RootNamespace>Lekman.Qualify.Tests</RootNamespace>
    <!-- Test classes are public because xUnit requires it; they are not an API. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="PdfPig" />
    <ProjectReference Include="../../src/Lekman.Qualify/Lekman.Qualify.csproj" />
  </ItemGroup>
</Project>

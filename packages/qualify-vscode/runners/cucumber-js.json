{
  "$schema": "./runner.schema.json",
  "id": "cucumber-js",
  "label": "cucumber-js",
  "framework": "cucumber",
  "files": ["**/*.feature"],
  "command": "${tool} cucumber-js ${filter}",
  "tools": [
    { "file": "bun.lock", "value": "bunx" },
    { "file": "bun.lockb", "value": "bunx" },
    { "file": "pnpm-lock.yaml", "value": "pnpm exec" },
    { "file": "yarn.lock", "value": "yarn" },
    { "value": "npx" }
  ],
  "select": {
    "term": "^${id}\\b",
    "join": " ",
    "quote": "each",
    "argument": "--name ${term}",
    "repeat": true
  },
  "results": "qualify-evidence"
}
